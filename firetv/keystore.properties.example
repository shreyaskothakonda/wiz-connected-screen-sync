# Copy to firetv/keystore.properties (git-ignored) and fill in. Paths are relative to firetv/.
# Create the keystore once with (JDK 21 keytool, from `source firetv/jdk.sh`):
#   keytool -genkeypair -v -keystore release.jks -alias screensync -keyalg RSA -keysize 2048 -validity 10000
# Keep release.jks and this file out of git and back them up: Amazon re-signs the store build,
# but sideloaded updates over an installed build must come from the same key.
storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=screensync
keyPassword=CHANGE_ME
