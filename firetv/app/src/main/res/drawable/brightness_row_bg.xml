<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/wiz_transparent" />
            <corners android:radius="@dimen/row_radius" />
            <stroke android:width="@dimen/stroke_focus" android:color="@color/wiz_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/wiz_transparent" />
            <corners android:radius="@dimen/row_radius" />
            <stroke android:width="@dimen/stroke_focus" android:color="@color/wiz_transparent" />
        </shape>
    </item>
</selector>
